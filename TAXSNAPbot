@bot.command()
async def income(ctx, amount: float, *, desc="Income"):
    add_tx(ctx.author.id, ctx.guild.id if ctx.guild else "DM", "income", amount, "income", "Client", desc)
    await ctx.send(f"💰 Income +${amount:.2f} logged: {desc}")

@bot.command()
async def expense(ctx, amount: float, category="other", *, vendor="Unknown"):
    valid = ['meals','travel','office','supplies','software','vehicle','marketing','other']
    if category not in valid:
        await ctx.send(f"Category must be one of {valid}. Using 'other'")
        category = "other"
    add_tx(ctx.author.id, ctx.guild.id if ctx.guild else "DM", "expense", amount, category, vendor, f"{category} expense")
    await ctx.send(f"📉 Expense -${amount:.2f} | {category} | {vendor} - Added as write-off!")

@bot.command(name="profit")
async def profit_cmd(ctx):
    income, expense, writeoffs, profit, rows = get_summary(ctx.author.id, ctx.guild.id if ctx.guild else "DM")
    embed = discord.Embed(title=f"📊 Profit Report for {ctx.author.display_name}", color=0x00ff00 if profit>=0 else 0xff0000)
    embed.add_field(name="Total Income", value=f"${income:.2f}", inline=True)
    embed.add_field(name="Total Expenses", value=f"${expense:.2f}", inline=True)
    embed.add_field(name="Write-Offs", value=f"${writeoffs:.2f}", inline=True)
    embed.add_field(name="NET PROFIT", value=f"${profit:.2f}", inline=False)
    embed.set_footer(text=f"{len(rows)} transactions tracked")
    await ctx.send(embed=embed)

@bot.command(name="writeoffs")
async def writeoffs_cmd(ctx):
    income, expense, writeoffs, profit, rows = get_summary(ctx.author.id, ctx.guild.id if ctx.guild else "DM")
    conn = sqlite3.connect("taxsnap.db")
    c = conn.cursor()
    c.execute("SELECT category, SUM(amount) FROM transactions WHERE user_id=? AND guild_id=? AND type='expense' GROUP BY category", (str(ctx.author.id), str(ctx.guild.id if ctx.guild else "DM")))
    by_cat = c.fetchall()
    conn.close()

    embed = discord.Embed(title="🧾 Write-Offs Breakdown", color=0x00aaff)
    for cat, total in by_cat:
        embed.add_field(name=cat.title(), value=f"${total:.2f}", inline=True)
    embed.add_field(name="TOTAL WRITE-OFFS", value=f"${writeoffs:.2f}", inline=False)
    await ctx.send(embed=embed)

@bot.command()
async def summary(ctx):
    await profit_cmd(ctx)

@bot.command()
async def export(ctx):
    conn = sqlite3.connect("taxsnap.db")
    c = conn.cursor()
    c.execute("SELECT type, amount, category, vendor, description, date FROM transactions WHERE user_id=? AND guild_id=?", (str(ctx.author.id), str(ctx.guild.id if ctx.guild else "DM")))
    rows = c.fetchall()
    conn.close()
    if not rows:
        await ctx.send("No data to export")
        return
    csv = "type,amount,category,vendor,description,date\n"
    for r in rows:
        csv += f"{r[0]},{r[1]},{r[2]},{r[3]},{r[4]},{r[5]}\n"

    with open("taxsnap_export.csv","w") as f:
        f.write(csv)
    await ctx.send(file=discord.File("taxsnap_export.csv"))

