import os
import re
import sqlite3
import discord
from discord.ext import commands
from datetime import datetime
import requests
from PIL import Image
import pytesseract
from io import BytesIO

TOKEN = os.getenv("DISCORD_TOKEN")
OCR_API_KEY = os.getenv("OCR_API_KEY", "helloworld") # free key, you can get your own at ocr.space

intents = discord.Intents.default()
intents.message_content = True
intents.messages = True

bot = commands.Bot(command_prefix="!", intents=intents)

# --- DATABASE ---
def init_db():
    conn = sqlite3.connect("taxsnap.db")
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS transactions (
        id INTEGER PRIMARY KEY,
        user_id TEXT,
        guild_id TEXT,
        type TEXT,
        amount REAL,
        category TEXT,
        vendor TEXT,
        description TEXT,
        date TEXT,
        receipt_url TEXT
    )''')
    conn.commit()
    conn.close()

def add_tx(user_id, guild_id, type_, amount, category, vendor, desc, receipt_url=""):
    conn = sqlite3.connect("taxsnap.db")
    c = conn.cursor()
    c.execute("INSERT INTO transactions (user_id, guild_id, type, amount, category, vendor, description, date, receipt_url) VALUES (?,?,?,?,?,?,?,?,?)",
              (str(user_id), str(guild_id), type_, amount, category, vendor, desc, datetime.now().strftime("%Y-%m-%d %H:%M"), receipt_url))
    conn.commit()
    conn.close()

def get_summary(user_id, guild_id):
    conn = sqlite3.connect("taxsnap.db")
    c = conn.cursor()
    c.execute("SELECT type, amount, category FROM transactions WHERE user_id=? AND guild_id=?", (str(user_id), str(guild_id)))
    rows = c.fetchall()
    conn.close()
    income = sum(r[1] for r in rows if r[0]=='income')
    expense = sum(r[1] for r in rows if r[0]=='expense')
    writeoffs = sum(r[1] for r in rows if r[0]=='expense' and r[2] in ['meals','travel','office','supplies','software','vehicle','marketing','other'])
    profit = income - expense
    return income, expense, writeoffs, profit, rows

def scan_receipt_with_ocr(image_bytes):
    # Uses free OCR.space API - works on Railway without heavy tesseract
    try:
        r = requests.post(
            'https://api.ocr.space/parse/image',
            files={'file': ('receipt.jpg', image_bytes)},
            data={'apikey': OCR_API_KEY, 'language': 'eng', 'isTable': True}
        )
        result = r.json()
        text = result['ParsedResults'][0]['ParsedText'] if result.get('ParsedResults') else ""
    except:
        # Fallback to local tesseract if API fails
        try:
            img = Image.open(BytesIO(image_bytes))
            text = pytesseract.image_to_string(img)
        except:
            text = ""

    # Parse amount and vendor from text
    amount = 0.0
    # Find $ amounts
    matches = re.findall(r'\$?\s?(\d+\.\d{2})', text)
    if matches:
        try:
            amount = max([float(m) for m in matches]) # assume biggest is total
        except:
            pass

    vendor = "Unknown"
    lines = text.split('\n')
    if lines:
        vendor = lines[0][:30].strip()

    return text, amount, vendor

@bot.event
async def on_ready():
    init_db()
    print(f"✅ TAXSNAP FULL SYSTEM ONLINE as {bot.user}")
    await bot.change_presence(activity=discord.Activity(type=discord.ActivityType.watching, name="!snap |!profit"))

@bot.event
async def on_message(message):
    # Auto receipt scanner - if someone uploads an image with receipt
    if message.attachments and not message.author.bot:
        for att in message.attachments:
            if att.filename.lower().endswith(('.png','.jpg','.jpeg','.webp')):
                await message.channel.send(f"📄 Scanning receipt from {message.author.mention}...")
                img_bytes = await att.read()
                text, amount, vendor = scan_receipt_with_ocr(img_bytes)

                if amount > 0:
                    add_tx(message.author.id, message.guild.id if message.guild else "DM", "expense", amount, "other", vendor, f"Auto-scanned receipt", att.url)
                    embed = discord.Embed(title="✅ Receipt Scanned!", color=0x00ff00)
                    embed.add_field(name="Vendor", value=vendor, inline=True)
                    embed.add_field(name="Amount", value=f"${amount:.2f}", inline=True)
                    embed.add_field(name="Write-Off?", value="Yes - Added to write-offs", inline=False)
                    embed.add_field(name="Text Found", value=text[:500] + "..." if len(text)>500 else text, inline=False)
                    embed.set_footer(text="Use!category <meals/travel/office/etc> to recategorize")
                    await message.channel.send(embed=embed)
                else:
                    await message.channel.send(f"⚠️ Couldn't find total. OCR Text:\n```{text[:1000]}```\nUse `!expense {amount} {category} {vendor}` manually")
    await bot.process_commands(message)

# COMMANDS
